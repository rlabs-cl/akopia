# Copy to `.env` and edit. docker-compose picks this up automatically.

# Docker Compose project name. Images and default network are prefixed
# with this value; changing it is how you isolate multiple Akopia stacks
# on the same host.
COMPOSE_PROJECT_NAME=akopia

# Auth — required. Clients send `Authorization: Bearer <this>` to the
# MCP server / concentrador API. Rotate regularly.
AKOPIA_BEARER_TOKEN=changeme-dev-only

# Strict auth. When set to `1`, the MCP server refuses to start if
# AKOPIA_BEARER_TOKEN is unset (fail-closed). Leave unset or `0` for
# permissive-dev (logs a warning + allows requests). Production MUST
# set AKOPIA_STRICT_AUTH=1.
# AKOPIA_STRICT_AUTH=1

# Meilisearch master key — required.
MEILI_MASTER_KEY=changeme-dev-only

# Host ports (optional — override if you already use these).
CONCENTRADOR_PORT=8080
EMBEDDINGS_PORT=8081
MCP_PORT=8082
QDRANT_PORT=6333
MEILI_PORT=7700

# Uncomment and set if any source adapter needs them.
# GITHUB_TOKEN=
# GITLAB_TOKEN=
# GITEA_TOKEN=

# Embedder throughput: how many EmbeddingJobs are pulled from Redis
# per XREADGROUP call AND processed concurrently via asyncio.gather
# (default 10, valid range 1–50). Raise when the backend is GPU-backed
# (Ollama) and per-job ms is low but CPU-idle is high. Out-of-range
# values are clamped with a warning, not fatal.
# EMBEDDER_BATCH_SIZE=10
