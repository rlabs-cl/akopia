FROM python:3.11-slim AS base
WORKDIR /app

COPY pyproject.toml ./
COPY common/ common/
COPY concentrador/ concentrador/
COPY adapters/ adapters/
COPY extractors/ extractors/
COPY scripts/ scripts/
COPY README.md ./

# Concentrador needs every extractor's *class* importable so the Router
# can read its supported_mime_types / supported_extensions / priority
# when dispatching events. Actual extraction runs in separate processes.
ARG EXTRAS=all-text
RUN pip install --no-cache-dir ".[${EXTRAS}]"

ENV PYTHONUNBUFFERED=1
EXPOSE 8080
CMD ["uvicorn", "concentrador.main:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1", "--log-level", "info"]
